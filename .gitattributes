# Normalize line endings: LF in the repo, auto-converted on checkout per platform.
* text=auto eol=lf

# Source and build files are always LF.
*.cpp   text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.cmake text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.rst   text eol=lf
*.md    text eol=lf
*.py    text eol=lf

# Shell scripts must stay LF even on Windows checkouts.
*.sh    text eol=lf
*.bash  text eol=lf

# Treat the prebuilt FFI library and binaries as binary (no EOL/diff munging).
*.so    binary
*.a     binary
*.dll   binary
*.lib   binary
*.dylib binary
*.png   binary
*.jpg   binary
